{
  "name": "saas-rapportini",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cross-env NODE_ENV=production npm run build --workspace=frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "npm run lint --workspace=frontend"
  },
  "dependencies": {
    "@types/ioredis": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.23.1",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.10"
  }
}
