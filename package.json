{
  "name": "saas-rapportini",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "migrate": "tsx server/migrations/cli.ts",
    "build": "cross-env NODE_ENV=production npm run build --workspace=frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "cross-env NODE_ENV=test vitest run --fileParallelism=false",
    "lint": "npm run lint --workspace=frontend",
    "typecheck:backend": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.0",
    "google-auth-library": "^11.1.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "vite": "^8.2.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
