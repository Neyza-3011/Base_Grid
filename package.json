{
  "name": "saas-rapportini",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "npm run lint --workspace=frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "esbuild": "^0.23.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  }
}
