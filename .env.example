# ==============================================================================
# BaseGrid - Environment Variables Template (.env.example)
# ==============================================================================

# --- Server & Runtime Environment ---
# Allowed values: development | production | test
NODE_ENV=development
PORT=3000

# --- Security & JWT ---
# Production requires a high-entropy string (min 32 characters, no placeholders)
JWT_SECRET=

# --- Persistence (PostgreSQL) ---
# Required in production (e.g., postgresql://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=

# --- Session & Distributed Token Store (Redis / Upstash) ---
# Required in production (e.g., rediss://default:password@host:port)
REDIS_URL=
# Fallback individual host/port parameters for local dev/testing
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Networking & CORS ---
# In production, specify the public Vercel frontend URL (e.g., https://app.yourdomain.com)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins for CORS. In production, MUST NOT contain localhost or 127.0.0.1
CORS_ORIGINS=http://localhost:5173

# --- Master Tenant / Super-Admin Seed ---
# Required in production to securely bootstrap the master administrative tenant
SUPERADMIN_EMAIL=admin@basegrid.io
SUPERADMIN_PASSWORD=
SUPERADMIN_COMPANY_NAME=BaseGrid Master Platform

# --- Email Service & Verification ---
# Set to false to disable email requirements (recommended default for current deployment gate)
EMAIL_VERIFICATION_ENABLED=false
# Required only if EMAIL_VERIFICATION_ENABLED=true in production ('resend' is supported)
EMAIL_PROVIDER=none
EMAIL_FROM=no-reply@basegrid.io
EMAIL_API_KEY=
# Optional SMTP parameters (if using smtp provider in custom environments)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Google OAuth Authentication ---
# Set to false to disable Google OAuth (recommended default for current deployment gate)
GOOGLE_AUTH_ENABLED=false
# Required only if GOOGLE_AUTH_ENABLED=true in production
GOOGLE_CLIENT_ID=
